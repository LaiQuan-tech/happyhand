# 快樂手 worker — 本機開發用環境變數
# 複製成 apps/worker/.env 後填值（.env 已被 .gitignore 忽略，不會進版控）

# ---- 必要 ------------------------------------------------------------------
# Supabase 專案 URL（Dashboard → Project Settings → API → Project URL）
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co

# service role key（同一頁的 service_role secret）
# ⚠️ 這把 key 會繞過所有 RLS，只能放在後端，絕不可出現在 apps/web 的 NEXT_PUBLIC_* 變數
SUPABASE_SERVICE_ROLE_KEY=

# ---- 選用 ------------------------------------------------------------------
# Resend API key。沒有設定 → 提醒信只記 log 不寄出（dry run）
RESEND_API_KEY=

# 寄件人；網域必須已在 Resend 完成驗證
MAIL_FROM=快樂手 <no-reply@happyhands.tw>

# 收件人按回覆時的信箱（選填）
MAIL_REPLY_TO=

# health check HTTP port，Railway 會自動注入 PORT
PORT=3001

# 1 = 強制 dry run：即使有 RESEND_API_KEY 也不會真的寄信。本機測試建議打開
WORKER_DRY_RUN=1

# debug | info | warn | error
LOG_LEVEL=debug
